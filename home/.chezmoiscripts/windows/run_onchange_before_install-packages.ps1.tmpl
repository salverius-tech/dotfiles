# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Required installations must fail so chezmoi retries incomplete setup.
$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

function Invoke-Native {
    param([string]$Command, [string[]]$Arguments)
    & $Command @Arguments
    if ($LASTEXITCODE -ne 0) {
        throw "$Command failed with exit code $LASTEXITCODE"
    }
}

function Update-SessionPath {
    $paths = @(
        [Environment]::GetEnvironmentVariable('Path', 'Machine'),
        [Environment]::GetEnvironmentVariable('Path', 'User'),
        "$env:APPDATA\npm", "$env:USERPROFILE\.bun\bin", $env:PATH
    )
    $env:PATH = ($paths -join ';')
}

function Install-WingetPackage {
    param([string]$Id, [string]$Command)
    if ($Command -and (Get-Command $Command -ErrorAction SilentlyContinue)) { return }
    $installed = winget list --id $Id --exact --accept-source-agreements 2>$null
    if ($LASTEXITCODE -ne 0 -or -not ($installed -match [regex]::Escape($Id))) {
        Invoke-Native winget @('install', '--id', $Id, '--exact', '--source', 'winget',
            '--accept-source-agreements', '--accept-package-agreements', '--silent')
    }
    Update-SessionPath
    if ($Command -and -not (Get-Command $Command -ErrorAction SilentlyContinue)) {
        throw "$Command is unavailable after installing $Id. Restart the shell and re-run chezmoi apply."
    }
}

$null = Get-Command winget -ErrorAction Stop
Update-SessionPath
Install-WingetPackage 'Git.Git' 'git'
Install-WingetPackage 'OpenJS.NodeJS.LTS' 'npm'
Invoke-Native node @('-e', 'const [a,b]=process.versions.node.split(".").map(Number); if(a<22 || (a===22 && b<19)) process.exit(1)')
Install-WingetPackage 'Starship.Starship' 'starship'
Install-WingetPackage 'Microsoft.VisualStudioCode' 'code'
Install-WingetPackage 'DEVCOM.JetBrainsMonoNerdFont' ''

if (-not (Get-Command bun -ErrorAction SilentlyContinue)) {
    if ([Environment]::OSVersion.Version.Build -lt 17763) {
        throw 'Bun requires Windows 10 build 17763 or newer.'
    }
    $installer = Join-Path ([IO.Path]::GetTempPath()) "$([guid]::NewGuid()).ps1"
    try {
        Invoke-WebRequest 'https://bun.sh/install.ps1' -OutFile $installer
        Invoke-Native powershell.exe @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $installer)
    } finally {
        Remove-Item $installer -ErrorAction SilentlyContinue
    }
    Update-SessionPath
    $null = Get-Command bun -ErrorAction Stop
}
if (-not (Get-Command pi -ErrorAction SilentlyContinue)) {
    Invoke-Native npm @('install', '-g', '@earendil-works/pi-coding-agent')
    Update-SessionPath
    $null = Get-Command pi -ErrorAction Stop
}
if (-not (Get-Command opencode -ErrorAction SilentlyContinue)) {
    Invoke-Native bun @('add', '-g', 'opencode-ai')
    Update-SessionPath
    $null = Get-Command opencode -ErrorAction Stop
}

# Service configuration and editor extensions are optional conveniences.
$IsAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if ($IsAdmin) {
    try {
        $agent = Get-Service ssh-agent -ErrorAction SilentlyContinue
        if ($agent) {
            Set-Service ssh-agent -StartupType Automatic
            Start-Service ssh-agent
        }
    } catch { Write-Warning "Optional SSH agent setup failed: $_" }
} else {
    Write-Host 'Skipping optional SSH service configuration (not elevated).'
}

$extensions = @(
    'usernamehw.errorlens', 'christian-kohler.path-intellisense',
    'esbenp.prettier-vscode', 'vscode-icons-team.vscode-icons', 'eamodio.gitlens',
    'ms-azuretools.vscode-docker', 'ms-python.python', 'ms-vscode.powershell',
    'yzhang.markdown-all-in-one', 'redhat.vscode-yaml', 'ms-vscode-remote.remote-ssh',
    'ms-vscode-remote.remote-wsl', 'ms-vscode-remote.remote-containers'
)
try {
    $installed = @(Invoke-Native code @('--list-extensions'))
    foreach ($extension in $extensions) {
        if ($installed -notcontains $extension) {
            Invoke-Native code @('--install-extension', $extension)
        }
    }
} catch {
    Write-Warning "Optional extensions incomplete; retry with code --install-extension <id>: $_"
}
Write-Host 'Required packages installed. Restart your terminal to load updated settings.'
