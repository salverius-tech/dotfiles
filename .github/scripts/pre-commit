#!/usr/bin/env bash
# Validate the index without changing the working tree, index, or stash stack.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"

echo 'Scanning staged changes...'
gitleaks git --staged --redact --config "$snapshot/.gitleaks.toml"

# Git exports repository-specific variables to hooks. Do not leak them into
# checks (including tests with temporary repositories) in the snapshot.
while IFS= read -r variable; do
    unset "$variable"
done < <(git rev-parse --local-env-vars)

make -C "$snapshot" test
echo 'Staged checks passed'
